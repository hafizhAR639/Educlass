<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF3F6"
    android:orientation="vertical">

    <!-- Header Section -->
    <include
        android:id="@+id/header_admin_statistik"
        layout="@layout/shared_layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Grid 2x2 Statistik Utama -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Card: Total User -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_white_r20_xml"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#A8D4FF"
                        android:padding="15dp"
                        android:src="@drawable/shared_ic_people"
                        app:tint="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="2,847"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total User"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Total Modul -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_white_r20_xml"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#C1ECA3"
                        android:padding="15dp"
                        android:src="@drawable/shared_ic_book"
                        app:tint="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="580"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Modul"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Aktif Hari Ini -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_white_r20_xml"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#D1FFBD"
                        android:padding="15dp"
                        android:src="@drawable/shared_ic_stats"
                        app:tint="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="1,279"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aktif Hari Ini"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Durasi Belajar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_card_white_r20_xml"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#E5D1FF"
                        android:padding="15dp"
                        android:src="@drawable/shared_ic_time"
                        app:tint="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="45m 15s"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avg. Durasi"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>
            </GridLayout>

            <!-- Section: Aktivitas Harian (Bar Chart Design from Node 829:721) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white_r20_xml"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="43dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Simple Tabs (Mingguan/Bulanan) -->
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Aktivitas Harian"
                            android:textColor="#000000"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="51dp"
                            android:background="@drawable/bg_card_white_r20"
                            android:backgroundTint="#F0F4F8"
                            android:orientation="horizontal"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/shared_bg_nav_indicator"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Mingguan"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Bulanan"
                                android:textColor="#808080"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Custom Bar Chart UI -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal">


                        <!-- Y-Axis Labels -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:text="100" android:textSize="10sp" android:textColor="#A8A8A8" />
                            <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:text="75" android:textSize="10sp" android:textColor="#A8A8A8" />
                            <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:text="50" android:textSize="10sp" android:textColor="#A8A8A8" />
                            <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:text="25" android:textSize="10sp" android:textColor="#A8A8A8" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="10sp" android:textColor="#A8A8A8" />
                        </LinearLayout>

                        <!-- Chart Content (Bars) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <!-- Bar Monday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="120dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="M" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Tuesday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="160dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Wednesday (Highlighted) -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="200dp" android:background="@drawable/shared_bg_nav_indicator" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="W" android:textSize="10sp" android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Bar Thursday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="180dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="T" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Friday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="140dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="F" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Saturday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="90dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="S" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Sunday -->
                            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal" android:orientation="vertical">
                                <View android:layout_width="24dp" android:layout_height="110dp" android:background="@drawable/shared_bg_nav_indicator" android:alpha="0.3" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="S" android:textSize="10sp" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
