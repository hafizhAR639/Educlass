<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF3F6"
    android:orientation="vertical">

    <!-- Header Section -->
    <include
        android:id="@+id/header_change_password"
        layout="@layout/shared_layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <!-- Form Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Password Lama -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password Lama"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/et_old_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@id/iv_show_old_password"
                            android:background="@android:color/transparent"
                            android:hint="Admin EduClass"
                            android:inputType="textPassword"
                            android:textColor="#101828"
                            android:textColorHint="#98A2B3"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iv_show_old_password"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/shared_ic_eye_on"
                            app:tint="#667085" />
                    </RelativeLayout>

                    <!-- Password Baru -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Password Baru"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/et_new_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@id/iv_show_new_password"
                            android:background="@android:color/transparent"
                            android:hint="admin@gmail.com"
                            android:inputType="textPassword"
                            android:textColor="#101828"
                            android:textColorHint="#98A2B3"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iv_show_new_password"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/shared_ic_eye_on"
                            app:tint="#667085" />
                    </RelativeLayout>

                    <!-- Konfirmasi Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Konfirmasi Password Baru"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7"
                        android:paddingHorizontal="16dp">

                        <EditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@id/iv_show_confirm_password"
                            android:background="@android:color/transparent"
                            android:hint="admin@gmail.com"
                            android:inputType="textPassword"
                            android:textColor="#101828"
                            android:textColorHint="#98A2B3"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/iv_show_confirm_password"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/shared_ic_eye_on"
                            app:tint="#667085" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btn_save_password_changes"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#347EFF"
            android:text="Simpan Perubahan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>