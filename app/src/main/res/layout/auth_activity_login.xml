<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="40dp"
    tools:ignore="ExtraText">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="146dp"
        android:layout_height="154dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:src="@drawable/shared_logo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <!-- ===== EMAIL FIELD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/shared_ic_mail"
                android:contentDescription="Email icon"
                app:tint="#3D4947" />

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Enter your email"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:importantForAutofill="no" />

        </LinearLayout>

        <!-- ===== PASSWORD FIELD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/shared_ic_lock"
                android:contentDescription="Password icon"
                app:tint="#3D4947" />

            <Space
                android:layout_width="12dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:textSize="14sp"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <!-- Eye toggle -->
            <ImageView
                android:id="@+id/icEye"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/shared_ic_eye_on"
                android:contentDescription="Toggle password"
                android:clickable="true"
                android:focusable="true"
                app:tint="#3D4947" />

        </LinearLayout>

        <!-- Forgot Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Forgot password?"
            android:textColor="#000000"
            android:textSize="12sp" />

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#337DFF"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Don't have account? Sign up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have account? "
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign up"
                android:textColor="#337DFF"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>