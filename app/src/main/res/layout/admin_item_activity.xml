<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white_r20_xml"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_activity_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_card_white_r20_xml"
        android:backgroundTint="#F2F4F7"
        android:padding="10dp"
        android:src="@drawable/shared_ic_time"
        app:tint="#347EFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_activity_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin menambahkan modul baru"
            android:textColor="#101828"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Baru saja"
            android:textColor="#667085"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>