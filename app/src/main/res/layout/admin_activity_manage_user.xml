<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF3F6"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header Section (Node 829:977) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:clipChildren="false">

        <!-- Blue Background with 40dp Bottom Radius -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/shared_bg_header_blue" />

        <!-- Title & Back (Node 838:723) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:paddingHorizontal="24dp">

            <ImageView
                android:id="@+id/btn_back_manage"
                android:layout_width="30dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_card_white_r20"
                android:backgroundTint="#FFFFFF"
                android:padding="6dp"
                android:src="@drawable/shared_ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Kelola User"
                android:textColor="#FFFFFF"
                android:paddingTop="5dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />
        </RelativeLayout>

        <!-- Floating Search Bar (Node 838:716) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="-0dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/shared_ic_search"
                    app:tint="#B0B0B0" />

                <EditText
                    android:id="@+id/et_search_user"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Cari nama atau email..."
                    android:textColor="#000000"
                    android:textColorHint="#B0B0B0"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- Filter Buttons (Node 837:537-539) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_filter_semua"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:background="@drawable/shared_bg_nav_indicator"
            android:gravity="center"
            android:text="Semua"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_filter_aktif"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_card_white_r20"
            android:gravity="center"
            android:text="Aktif"
            android:textColor="#000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_filter_tidak_aktif"
            android:layout_width="88dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_card_white_r20"
            android:gravity="center"
            android:text="Tidak Aktif"
            android:textColor="#000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_manage_users"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        tools:listitem="@layout/admin_item_user" />

</LinearLayout>
