<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF3F6"
    android:orientation="vertical">

    <include
        android:id="@+id/header_edit_materi"
        layout="@layout/shared_layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <!-- Card: Informasi Dasar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Dasar"
                        android:textStyle="bold"
                        android:textColor="#000000" />
                    <EditText
                        android:id="@+id/et_edit_materi_title"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="Judul Materi"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                    <EditText
                        android:id="@+id/et_edit_materi_desc"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:hint="Deskripsi Singkat"
                        android:gravity="top"
                        android:padding="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                    <EditText
                        android:id="@+id/et_edit_materi_duration"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="Durasi (contoh: 45 Menit)"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Konten Visual -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konten Visual"
                        android:textStyle="bold"
                        android:textColor="#D92D20" />
                    <EditText
                        android:id="@+id/et_edit_visual_text"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="8dp"
                        android:hint="Teks Konten Visual"
                        android:gravity="top"
                        android:padding="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                    <EditText
                        android:id="@+id/et_edit_visual_video_url"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="Video URL"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Konten Audio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konten Auditori"
                        android:textStyle="bold"
                        android:textColor="#3538CD" />
                    <EditText
                        android:id="@+id/et_edit_audio_url"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="Audio URL"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: Konten Kinestetik -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konten Kinestetik"
                        android:textStyle="bold"
                        android:textColor="#B54708" />
                    <EditText
                        android:id="@+id/et_edit_kin_url"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:hint="Kinestetik Content URL"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#F2F4F7" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_materi"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Update Materi"
                android:textStyle="bold"
                android:backgroundTint="#347EFF"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_materi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Hapus Materi"
                android:textColor="#D92D20"
                app:strokeColor="#D92D20"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
