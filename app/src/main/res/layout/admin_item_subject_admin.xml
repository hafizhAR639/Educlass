<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="8dp">

    <RelativeLayout
        android:layout_width="80dp"
        android:layout_height="110dp">

        <!-- Background Rounded Box -->
        <!-- ID MUST BE layout_subject_bg and COMPONENT MUST BE CardView to match AdapterSubject.java -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layout_subject_bg"
            android:layout_width="77dp"
            android:layout_height="79dp"
            android:layout_alignParentBottom="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#C5A6E9">

            <!-- Subject Name -->
            <TextView
                android:id="@+id/tv_subject_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="Physics"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="4dp" />

        </androidx.cardview.widget.CardView>

        <!-- Circular Icon -->
        <ImageView
            android:id="@+id/iv_subject_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:elevation="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/shared_ic_phys" />

    </RelativeLayout>
</LinearLayout>
