<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- HEADER BLUE AREA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:clipChildren="false">

                <!-- Blue Background with rounded bottom -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="@drawable/shared_bg_header_rounded_pill_large" />

                <!-- Top Bar (Profile, Greeting, Icons) -->
                <LinearLayout
                    android:id="@+id/layout_header_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:paddingHorizontal="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_user_profile"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_ic_profile"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Hallo, Dea 👋"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_premium_badge"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/shared_ic_premium" />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/iv_notification_bell"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/shared_ic_bell"
                                app:tint="#FFFFFF" />
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentTop="true"
                                android:layout_marginTop="-2dp"
                                android:layout_marginEnd="-2dp"
                                android:background="@drawable/nav_item_circle"
                                android:backgroundTint="#FF5252" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tv_highlight_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hukum Newton"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_highlight_progress_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="65% completed"
                                android:textColor="#E0E0E0"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginEnd="100dp"
                                android:background="@drawable/shared_bg_progress_track"
                                android:weightSum="100">

                                <View
                                    android:id="@+id/view_progress_fill"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="65"
                                    android:background="@drawable/shared_bg_progress_fill" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Progress Card (Dashboard) -->
                <RelativeLayout
                    android:id="@+id/layout_highlight_card"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_below="@id/layout_header_top"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/user_bg_card_highlight"
                    android:clipChildren="false">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.2"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_img_header_math" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_continue"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="16dp"
                        android:paddingHorizontal="16dp"
                        android:text="Lanjutkan"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="18dp"
                        app:elevation="4dp" />
                </RelativeLayout>

                <!-- Search Bar (Floating) -->
                <LinearLayout
                    android:id="@+id/layout_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/shared_bg_search_bar"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/shared_ic_search"
                        app:tint="#B0B0B0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Cari topik yang ingin dipelajari"
                        android:textColor="#B0B0B0"
                        android:textSize="14sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- MATA PELAJARAN TERPOPULER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="Mata Pelajaran Terpopuler"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_subjects_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp" />

            <!-- MATERI TERPOPULER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="Materi Terpopuler"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_popular_topics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                tools:listitem="@layout/user_item_topic_popular" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
