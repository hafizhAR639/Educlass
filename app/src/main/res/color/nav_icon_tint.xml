<?xml version="1.0" encoding="utf-8"?>
<!--
    SIMPAN DI: res/color/nav_icon_tint.xml
    (folder COLOR, bukan drawable!)

    Fungsi: mengatur warna icon di tiap kondisi
    - Saat aktif   → icon warna #347EFF (SAMA dengan warna navbar)
                     Di atas lingkaran putih, icon terlihat "berlubang"
                     karena warnanya menyatu dengan background navbar
    - Saat nonaktif → icon putih (#FFFFFF) di atas background biru
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AKTIF: warna icon = warna navbar → efek berlubang -->
    <item android:state_checked="true"
        android:color="#347EFF" />

    <!-- TIDAK AKTIF: putih -->
    <item android:color="#FFFFFF" />

</selector>