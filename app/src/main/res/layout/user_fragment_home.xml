<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/scroll_view_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EFF3F6"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <RelativeLayout
                android:id="@+id/layout_header_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout_header_blue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shared_bg_header_blue"
                        android:orientation="vertical"
                        android:paddingHorizontal="36dp"
                        android:paddingTop="64dp"
                        android:paddingBottom="60dp">

                        <!-- Header dengan foto profil -->
                        <LinearLayout
                            android:id="@+id/layout_user_profile_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_user_profile"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginEnd="9dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/user_ic_profile" />

                            <TextView
                                android:id="@+id/tv_greeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hallo, Dea 👋 "
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/view_spacer_header"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/iv_premium_badge"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/shared_ic_premium" />

                            <ImageView
                                android:id="@+id/iv_notification_bell"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/shared_ic_bell" />
                        </LinearLayout>

                        <!-- Card Highlight dengan progress bar horizontal -->
                        <RelativeLayout
                            android:id="@+id/layout_highlight_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/user_bg_card_highlight"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:padding="16dp">

                            <!-- Background dekoratif -->
                            <ImageView
                                android:id="@+id/iv_highlight_bg_decor"
                                android:layout_width="-50dp"
                                android:layout_height="-100dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="-10dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/shared_bg_rect_black" />

                            <!-- Judul materi -->
                            <TextView
                                android:id="@+id/tv_highlight_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="20dp"
                                android:text="Hukum Newton"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <!-- Progress percentage -->
                            <TextView
                                android:id="@+id/tv_highlight_progress_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tv_highlight_title"
                                android:layout_marginTop="10dp"
                                android:text="65% completed"
                                android:paddingStart="20dp"
                                android:textColor="#F0F2FF"
                                android:textSize="14sp" />

                            <!-- Progress bar dan tombol dalam horizontal layout -->
                            <!-- Progress bar (Sekarang berdiri sendiri) -->
                            <LinearLayout
                                android:id="@+id/layout_progress_bar_container"
                                android:layout_width="match_parent"
                                android:layout_height="15dp"
                                android:layout_below="@id/tv_highlight_progress_text"
                                android:layout_marginTop="16dp"
                                android:layout_marginHorizontal="20dp"
                                android:background="@drawable/shared_bg_progress_track"
                                android:weightSum="100">

                                <View
                                    android:id="@+id/view_progress_fill"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="65"
                                    android:background="@drawable/shared_bg_progress_fill" />
                            </LinearLayout>

                            <!-- Tombol Lanjutkan (Sekarang berada di bawah progress bar) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_continue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/layout_progress_bar_container"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="12dp"
                                android:layout_marginEnd="20dp"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:text="Lanjutkan"
                                android:textAllCaps="false"
                                android:textColor="#000000"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="20dp"
                                app:elevation="6dp" /></RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Search bar dengan margin negatif -->
                <LinearLayout
                    android:id="@+id/layout_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginHorizontal="34dp"
                    android:layout_marginBottom="-20dp"
                    android:background="@drawable/shared_bg_search_bar"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="15dp">

                    <ImageView
                        android:id="@+id/iv_search_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/shared_ic_search" />

                    <TextView
                        android:id="@+id/tv_search_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cari topik yang ingin dipelajari"
                        android:textColor="#B0B0B0" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Mata Pelajaran Terpopuler -->
            <TextView
                android:id="@+id/tv_popular_subjects_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="31dp"
                android:text="Mata Pelajaran Terpopuler"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_subjects_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:layout_marginHorizontal="31dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <!-- Materi Terpopuler -->
            <TextView
                android:id="@+id/tv_popular_topics_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="31dp"
                android:text="Materi Terpopuler"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layout_popular_topics_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="39dp"
                android:layout_marginEnd="12dp"
                android:layout_marginStart="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Material: Aljabar -->
                <LinearLayout
                    android:id="@+id/layout_card_aljabar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/shared_bg_card_white"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/layout_aljabar_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/layout_aljabar_image_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <ImageView
                                android:id="@+id/iv_aljabar_thumb"
                                android:layout_width="match_parent"
                                android:layout_height="111dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/user_img_topic_aljabar" />

                            <RelativeLayout
                                android:id="@+id/layout_aljabar_badge_wrapper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentRight="true"
                                android:layout_marginBottom="-16dp"
                                android:layout_marginEnd="9dp"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <ImageView
                                    android:id="@+id/iv_aljabar_badge_bg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:scaleType="fitXY"
                                    android:src="@drawable/shared_bg_nav_indicator" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:orientation="vertical"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="14dp">

                                    <TextView
                                        android:id="@+id/tv_aljabar_badge_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Gratis"
                                        android:textColor="#FFFFFF"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </RelativeLayout>
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tv_aljabar_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Aljabar"
                            android:textColor="#000000"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_aljabar_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/layout_aljabar_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="17dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_aljabar_stats_icon"
                                android:layout_width="11dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="2dp"
                                android:src="@drawable/shared_ic_stats" />

                            <TextView
                                android:id="@+id/tv_aljabar_views_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10rb"
                                android:textColor="#A8A8A8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Material: Pertidaksamaan -->
                <LinearLayout
                    android:id="@+id/layout_card_pertidaksamaan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/shared_bg_card_white"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/iv_pertidaksamaan_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="111dp"
                        android:layout_marginBottom="7dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/user_img_topic_pertidaksamaan" />

                    <TextView
                        android:id="@+id/tv_pertidaksamaan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:layout_marginStart="11dp"
                        android:text="Pertidaksamaan"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layout_pertidaksamaan_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="end"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/layout_pertidaksamaan_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="17dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_pertidaksamaan_stats_icon"
                                android:layout_width="11dp"
                                android:layout_height="12dp"
                                android:layout_marginEnd="2dp"
                                android:src="@drawable/shared_ic_stats" />

                            <TextView
                                android:id="@+id/tv_pertidaksamaan_views_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15rb"
                                android:textColor="#A8A8A8"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>