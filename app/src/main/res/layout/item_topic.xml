<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_subject"
    android:elevation="2dp"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Header Modul (Biru/Dinamis) -->
    <LinearLayout
        android:id="@+id/layout_topic_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#347EFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_topic_index"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_math"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_topic_judul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Topik"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_topic_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ketuk untuk melihat materi visual"
                android:textColor="#D9DEE6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Konten Modul (Statis/Dinamis sesuai kebutuhan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_transparent_capsule"
                    android:backgroundTint="#FEE4E2"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="🎥 Video"
                    android:textColor="#D92D20"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_transparent_capsule"
                    android:backgroundTint="#E0EAFF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="📊 Infografis"
                    android:textColor="#3538CD"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_transparent_capsule"
                    android:backgroundTint="#D1FADF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="📝 Kuis"
                    android:textColor="#027A48"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱ 45 Menit"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selesai 0%"
                android:textColor="#027A48"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_track" />
    </LinearLayout>
</LinearLayout>
