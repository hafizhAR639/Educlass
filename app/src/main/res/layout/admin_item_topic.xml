<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/shared_bg_card_rounded"
    android:backgroundTint="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical">

    <!-- Card Header (Biru) -->
    <RelativeLayout
        android:id="@+id/layout_topic_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#347EFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_topic_index"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="@drawable/shared_bg_circle_blue"
            android:backgroundTint="#DBEAFE"
            android:gravity="center"
            android:text="1"
            android:textColor="#347EFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/tv_topic_index"
            android:layout_toStartOf="@id/btn_edit_topic"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_topic_judul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Topik"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_topic_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelola materi di sini"
                android:textColor="#D9DEE6"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_edit_topic"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/shared_ic_more"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- VAK Tags -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_vak_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tag_visual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shared_bg_tag_capsule"
                    android:backgroundTint="#FEE4E2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="🎥 Video"
                    android:textColor="#D92D20"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tag_auditori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/shared_bg_tag_capsule"
                    android:backgroundTint="#E0EAFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="📊 Infografis"
                    android:textColor="#3538CD"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tag_kinestetik"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shared_bg_tag_capsule"
                    android:backgroundTint="#D1FADF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="📝 Kuis"
                    android:textColor="#027A48"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Time & Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱ 45 Menit"
                android:textColor="#4A5565"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#027A48"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:progress="0"
            android:progressDrawable="@drawable/shared_bg_progress_track" />
    </LinearLayout>
</LinearLayout>