<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Header Section -->
            <RelativeLayout
                android:id="@+id/header_section"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/shared_bg_header_rounded_pill">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="40dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/shared_ic_back" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_learning_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visual"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_topic_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Judul Topik"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_content_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2 Konten • 45 menit"
                        android:textColor="#BFDBFE"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Pomodoro Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pomodoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-30dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iv_timer_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/shared_bg_tag_ipa"
                            android:backgroundTint="#3B82F6"
                            android:padding="6dp"
                            android:src="@drawable/shared_ic_stats"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@id/iv_timer_icon"
                            android:text="Fokus Belajar"
                            android:textColor="#101828"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_sessions_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="🍅 0 Selesai"
                            android:textColor="#D92D20"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_timer_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:text="25:00"
                        android:textColor="#101828"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_timer_mode_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="25 menit sesi fokus"
                        android:textColor="#667085"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_timer_control"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:text="Mulai"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            app:backgroundTint="#3B82F6"
                            app:cornerRadius="16dp"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconGravity="textStart" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_timer_reset"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="12dp"
                            app:cardBackgroundColor="#F2F4F7"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/stat_notify_sync"
                                app:tint="#101828" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Content Area -->
            <LinearLayout
                android:id="@+id/content_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="32dp">

                <LinearLayout
                    android:id="@+id/content_info_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_content_type_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardBackgroundColor="#FEE4E2"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:id="@+id/iv_content_type_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_slideshow"
                                app:tint="#D92D20" />
                        </com.google.android.material.card.MaterialCardView>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tv_content_type_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Video Pembelajaran"
                                android:textColor="#101828"
                                android:textStyle="bold"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tv_content_step"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Konten 1 dari 2"
                                android:textColor="#667085"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pb_content"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="16dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/shared_bg_progress_fill" />
                </LinearLayout>

                <!-- Video View Frame -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <FrameLayout
                        android:id="@+id/layout_video_container"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@drawable/shared_bg_rect_rounded"
                        android:backgroundTint="#000000">

                        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                            android:id="@+id/youtube_player_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:autoPlay="false"
                            app:enableAutomaticInitialization="false" />

                        <VideoView
                            android:id="@+id/native_video_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <!-- Integrated Media Controls Overlay -->
                        <LinearLayout
                            android:id="@+id/layout_video_controls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#99000000"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/iv_video_volume"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_lock_silent_mode_off"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/tv_video_current_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="00:00"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <SeekBar
                                android:id="@+id/video_seekbar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:progress="0"
                                android:thumbTint="#FFFFFF"
                                android:progressTint="#FFFFFF"
                                android:max="100" />

                            <TextView
                                android:id="@+id/tv_video_total_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="00:00"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <ImageView
                                android:id="@+id/btn_skip_back"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_rew"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/btn_video_play_pause"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_play"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/btn_skip_forward"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_ff"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/btn_video_landscape"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="12dp"
                                android:src="@android:drawable/ic_menu_crop"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Speed Control Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_video_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_alignTop="@id/layout_video_container"
                        android:layout_alignEnd="@id/layout_video_container"
                        android:layout_margin="12dp"
                        app:cardBackgroundColor="#99000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="6dp"
                        app:strokeWidth="0dp">
                        <TextView
                            android:id="@+id/tv_video_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="1.0x"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </RelativeLayout>

                <!-- Podcast Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_podcast_player"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#3B82F6"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="10dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/iv_podcast_cover"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/shared_bg_grad_blue" />
                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@android:drawable/ic_btn_speak_now"
                                    app:tint="#FFFFFF" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tv_podcast_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:gravity="center"
                                android:text="Podcast: Memahami materi"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_podcast_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Podcast Pembelajaran"
                                android:textColor="#BFDBFE"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Integrated Audio Controls -->
                        <LinearLayout
                            android:id="@+id/layout_audio_controls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="#33000000"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:id="@+id/iv_audio_volume"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@android:drawable/ic_lock_silent_mode_off"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:id="@+id/tv_audio_current_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="00:00"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <SeekBar
                                android:id="@+id/audio_seekbar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:progress="0"
                                android:thumbTint="#FFFFFF"
                                android:progressTint="#FFFFFF"
                                android:max="100" />

                            <TextView
                                android:id="@+id/tv_audio_total_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="00:00"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <ImageView
                                android:id="@+id/btn_audio_skip_back"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_rew"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/btn_audio_play_pause"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_play"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/btn_audio_skip_forward"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:src="@android:drawable/ic_media_ff"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>


                <!-- Reading Content Card (Shown for Content 2) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_reading_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_reading_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MATERI PEMBELAJARAN"
                            android:textColor="#101828"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:id="@+id/tv_explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Materi teks di sini..."
                            android:textColor="#344054"
                            android:textSize="15sp"
                            android:lineSpacingMultiplier="1.5" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Footer Navigation -->
                <LinearLayout
                    android:id="@+id/footer_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_prev"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="← Sebelumnya"
                        android:textAllCaps="false"
                        android:textColor="#667085"
                        app:cornerRadius="16dp"
                        app:strokeColor="#E5E7EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_next"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Selanjutnya →"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:backgroundTint="#3B82F6"
                        app:cornerRadius="16dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
