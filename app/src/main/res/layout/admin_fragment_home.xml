<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF3F6"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER SECTION -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/header_blue_bg"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/shared_bg_header_rounded_pill_large" />

                <!-- Profile Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:layout_marginHorizontal="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ic_profile_avatar"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/shared_profile_pic"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/ic_profile_avatar"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selamat Datang,"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admin 👋"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ic_notification_bell"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/shared_ic_bell_notif" />
                </RelativeLayout>

                <!-- Search Bar -->
                <LinearLayout
                    android:id="@+id/ll_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_alignBottom="@id/header_blue_bg"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginBottom="-30dp"
                    android:background="@drawable/shared_bg_search_bar"
                    android:elevation="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/shared_ic_search"
                        app:tint="#B0B0B0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Cari"
                        android:textColor="#B0B0B0"
                        android:textSize="16sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- CONTENT SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginHorizontal="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Akses Cepat"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Quick Access Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="horizontal">

                    <!-- Tambah Modul -->
                    <LinearLayout
                        android:id="@+id/rl_btn_tambah_modul"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#D7F4E3"
                        android:padding="12dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <View
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/nav_item_circle"
                            android:backgroundTint="#FFFFFF" />
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="-37dp"
                            android:src="@drawable/shared_ic_book"
                            app:tint="#000000" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Tambah\nmodul"
                            android:gravity="center"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Kelola User -->
                    <LinearLayout
                        android:id="@+id/rl_btn_kelola_user"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#FCECD7"
                        android:padding="12dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <View
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/nav_item_circle"
                            android:backgroundTint="#FFFFFF" />
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="-37dp"
                            android:src="@drawable/shared_ic_user_filled"
                            app:tint="#000000" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Kelola User"
                            android:gravity="center"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Statistik -->
                    <LinearLayout
                        android:id="@+id/rl_btn_statistik"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:backgroundTint="#D7E7FC"
                        android:padding="12dp"
                        android:gravity="center"
                        android:orientation="vertical">
                        <View
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/nav_item_circle"
                            android:backgroundTint="#FFFFFF" />
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="-37dp"
                            android:src="@drawable/shared_ic_stats"
                            app:tint="#000000" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Statistik"
                            android:gravity="center"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- STATISTICS GRID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Total User -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_card_white_r20_xml"
                            android:backgroundTint="#A8D4FF"
                            android:padding="12dp"
                            android:src="@drawable/shared_ic_people"
                            app:tint="#000000" />
                        <TextView
                            android:id="@+id/tv_total_user"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="2,847"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total User"
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Total Modul -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_card_white_r20_xml"
                            android:backgroundTint="#A8E8FF"
                            android:padding="12dp"
                            android:src="@drawable/shared_ic_book"
                            app:tint="#000000" />
                        <TextView
                            android:id="@+id/tv_total_modul"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="580"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Modul"
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="100dp"
                    android:orientation="horizontal">

                    <!-- Aktif Hari Ini -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_card_white_r20_xml"
                            android:backgroundTint="#C1F4A1"
                            android:padding="12dp"
                            android:src="@drawable/shared_ic_stats"
                            app:tint="#000000" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="1,279"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aktif Hari Ini"
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Durasi Belajar -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card_white_r20_xml"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <ImageView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_card_white_r20_xml"
                            android:backgroundTint="#E5D1FF"
                            android:padding="12dp"
                            android:src="@drawable/shared_ic_time"
                            app:tint="#000000" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="45m 15s"
                            android:textColor="#000000"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rata-rata Durasi"
                            android:textColor="#808080"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
